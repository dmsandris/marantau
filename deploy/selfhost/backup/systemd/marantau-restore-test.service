[Unit]
Description=Marantau - backup + tes restore mingguan
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=marantau
Group=marantau
SupplementaryGroups=docker
ExecStart=/opt/marantau/selfhost/backup/backup-vps.sh restore-test
TimeoutStartSec=90min
Nice=10
IOSchedulingClass=idle
