[Unit]
Description=Marantau - backup database VM ke Google Drive
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=marantau
Group=marantau
SupplementaryGroups=docker
ExecStart=/opt/marantau/selfhost/backup/backup-vps.sh backup
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
