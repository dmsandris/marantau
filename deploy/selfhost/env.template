# Template .env server Marantau. File .env ASLI hanya ada di VM (/opt/marantau/selfhost/.env),
# dibuat sekali oleh gen-env.sh. JANGAN commit .env.
# Nilai bertanda __GEN__ diisi acak oleh gen-env.sh.

COMPOSE_PROFILES=https

API_DOMAIN=api.marantau.web.id
OPS_DOMAIN=ops.marantau.web.id
API_EXTERNAL_URL=https://api.marantau.web.id
SITE_URL=https://dmsandris.github.io/marantau/
ADDITIONAL_REDIRECT_URLS=
ACME_EMAIL=__ACME_EMAIL__

POSTGRES_PASSWORD=__GEN__
JWT_SECRET=__GEN__
ANON_KEY=__GEN__
SERVICE_ROLE_KEY=__GEN__
SECRET_KEY_BASE=__GEN__
REALTIME_DB_ENC_KEY=__GEN__
DASHBOARD_PASSWORD=__GEN__
MT_OPS_RO_PASSWORD=__GEN__

# 1 jam, sama dengan cloud.
JWT_EXPIRY=3600

# Setelan Postgres untuk VM 4 GB
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=2560MB
PG_WORK_MEM=4MB
PG_MAX_CONNECTIONS=60
PGRST_DB_POOL=8
