# HTTPS otomatis (Let's Encrypt) untuk server Marantau.
# api.<domain> : hanya jalur yang dipakai game (auth, rest, realtime) + /uji/ (versi uji game, Fase 2).
#                Selain itu 404.
# ops.<domain> : Panel Ops (1.5), login sandi + 2FA. /wb/* = Workbench (container terpisah, sesi yang sama).
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

{$API_DOMAIN} {
	encode zstd gzip

	@game path /auth/v1/* /rest/v1/* /realtime/v1/*
	handle @game {
		reverse_proxy api-gw:8000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Versi uji game (Fase 2): asal (origin) terpisah dari GitHub Pages -> localStorage/sesi tidak
	# bercampur dengan game asli. Berkas dikirim workflow "VPS web uji" ke /opt/marantau/uji.
	redir /uji /uji/ 308
	handle_path /uji/* {
		root * /srv/uji
		@segar path / /index.html /config.js /version.json
		header @segar Cache-Control "no-cache"
		header X-Robots-Tag "noindex, nofollow"
		file_server
	}

	handle {
		respond "Marantau API" 404
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}
	log {
		output stdout
		format json
	}
}

{$OPS_DOMAIN} {
	encode zstd gzip

	# Workbench: container terpisah. Login memakai cookie sesi Panel Ops (diperiksa oleh Workbench sendiri).
	redir /wb /wb/ 308
	handle_path /wb/* {
		reverse_proxy workbench:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy ops:8080
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
